{% extends 'base.html.twig' %}

{% block title %}Admin Login{% endblock %}

{% block body %}
<div class="container" style="margin-top: 50px; max-width: 400px;">
    <form method="post">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <h1 class="h3 mb-3 font-weight-normal">Вход в Админ-панель</h1>
        
        <div class="mb-3">
            <label for="inputPhone">Телефон</label>
            <input type="text" value="{{ last_username }}" name="_username" id="inputPhone" class="form-control" required autofocus placeholder="79123456789">
        </div>
        
        <div class="mb-3">
            <label for="inputPassword">Пароль</label>
            <input type="password" name="_password" id="inputPassword" class="form-control" required>
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary w-100" type="submit">
            Войти в админ-панель
        </button>
    </form>
</div>
{% endblock %}